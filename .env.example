# Environment Variables Template
# Copy this file to .env for local development (if needed)
# For production deployment, set these in your Render dashboard

# API URL - The backend API endpoint
# Development: http://localhost:7194
# Production: https://your-api.onrender.com
API_URL=https://your-api-url.onrender.com

# Enable Google Analytics or other analytics services
# Set to 'true' to enable, 'false' to disable
ENABLE_ANALYTICS=true

# Local storage key for authentication token
TOKEN_KEY=mtg_auth_token

# Local storage key for user data
USER_KEY=mtg_auth_user
